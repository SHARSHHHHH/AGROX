# Sustainable Agriculture AI Advisory Platform — Gemini configuration
APP_NAME="Sustainable Agriculture AI Advisory Platform"
DATABASE_URL="sqlite:///./agri.db"
JWT_SECRET="generate-with-openssl-rand-hex-32"
DEMO_MODE=true

# Google AI Studio / Gemini API
# Create your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY="your-key-from-https://aistudio.google.com/apikey"
GEMINI_MODEL="gemini-3.7-flash"
VISION_MODEL="gemini-3.7-flash"

# Speech-to-text is independent of Gemini
STT_PROVIDER="whisper"
WHISPER_MODEL="base"

# Weather — Open-Meteo works without a key
WEATHER_API_URL="https://api.open-meteo.com/v1/forecast"
WEATHER_API_KEY=""

# --- Performance tuning (added) ---------------------------------------
# Reasoning budget for gemini-3.7-flash, in tokens.
#   0  = thinking OFF. Fastest. Correct choice here, because the agronomic
#        facts are computed by our own deterministic engines and the model is
#        only phrasing them.
#  512 = light reasoning
#  -1  = model decides (SLOWEST — this is what caused the long waits)
GEMINI_THINKING_BUDGET=0

# Cap the reply length. Farmer answers are short; uncapped output costs
# latency and tokens.
GEMINI_MAX_OUTPUT_TOKENS=1024

# ============================================================
# LLM PROVIDER SELECTION
# ============================================================
# "groq"   = Groq cloud API. FASTEST option (LPU inference, ~0.3-1s per
#            reply). Needs GROQ_API_KEY, free at https://console.groq.com/keys
# "gemini" = Google Gemini API. Needs GEMINI_API_KEY.
# "qwen"   = local Qwen2.5 via transformers. Offline, no API key, no rate
#            limits, but slow on CPU (tens of seconds per reply).
LLM_PROVIDER=groq

# --- Groq ---
# Create a free key at https://console.groq.com/keys (no credit card needed)
GROQ_API_KEY="your-key-from-https://console.groq.com/keys"
# openai/gpt-oss-120b = best quality/speed balance.
# openai/gpt-oss-20b  = even faster, slightly less capable.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_OUTPUT_TOKENS=350
GROQ_TIMEOUT_S=12

# --- Local Qwen (fallback / offline mode) ---
QWEN_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# Main latency control on CPU. Generation time scales with output length.
QWEN_MAX_NEW_TOKENS=200
# Hard ceiling on a single generation, seconds. Raise on slow CPUs.
QWEN_TIMEOUT_S=120

# --- Vision ---
# "gemini" = Gemini vision (working)
# "huggingface" = local HF vision model (STUB — raises, not implemented)
VISION_PROVIDER=groq
HF_VISION_MODEL=Kathir56/plant-disease-tamilnadu
# Confidence gates. Raise to reject more borderline images.
HF_VISION_MIN_CONFIDENCE=0.60
HF_VISION_MIN_MARGIN=0.15
HF_VISION_MAX_ENTROPY=0.55
# Set false to guarantee NO request ever leaves your machine (no Gemini key
# needed at all). True lets a failed local model fall back to the API.
VISION_ALLOW_FALLBACK=true

# --- Data sources ---
# true  = market/fertilizer services may return clearly MOCK-tagged samples
# false = they return an explicit "unavailable" instead. Use false in
#         production so no invented price can ever reach a farmer.
ALLOW_MOCK_MARKET_DATA=true

# ============================================================
# DATA.GOV.IN — AGMARKNET mandi prices
# Register free at https://data.gov.in to get a key.
# Server side only. NEVER expose to the frontend.
# ============================================================
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# ============================================================
# GOOGLE EARTH ENGINE — Sentinel-2 NDVI
# Server side only. NEVER expose to the frontend.
# No imagery is downloaded; only summary statistics are fetched.
# ============================================================
GEE_ENABLED=true
GEE_PROJECT=sustainable-agriculture-507214
# Leave all three blank to use the credentials `earthengine authenticate`
# already stored for this user (this is the configured setup).
GEE_SERVICE_ACCOUNT_JSON=
GEE_SERVICE_ACCOUNT_FILE=
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_BUFFER_M=100
GEE_MAX_CLOUD_PCT=60
GEE_MIN_VALID_FRACTION=0.40
GEE_LOOKBACK_DAYS=30
GEE_CACHE_TTL_S=21600
GEE_TIMEOUT_S=60

# --- Server-side text to speech (Tamil / Hindi voice) ---
TTS_ENABLED=true
TTS_CACHE_DIR=tts_cache

# --- Groq vision (plant disease + pest photos) ---
# Reuses GROQ_API_KEY above. Groq retires vision models often; if you get a
# 404, check https://console.groq.com/docs/models and update this.
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_VISION_TIMEOUT_S=60
GROQ_VISION_MAX_TOKENS=700

# --- Browser push notifications (optional) ---
# Alerts always appear in-app. Push only works once VAPID keys are set.
PUSH_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=admin@example.com

# Skip weather/satellite/market enrichment entirely. The crop ranking is
# unaffected — it needs no network. Use for demos or a poor connection.
DEMO_FAST_MODE=true
